}

/* ---------------- USER MESSAGE BUBBLE ---------------- */

.user-row {
    display: flex;
    justify-content: flex-end;
    width: 100%;
    margin: 15px 0 20px;
}

.user-bubble {
    background: #DFEBFF;
    border: 1px solid #D0E1FB;
    color: #244E83 !important;
    padding: 14px 19px;
    border-radius: 18px 18px 4px 18px;
    max-width: 78%;
    font-size: 15.5px;
    line-height: 1.85;
    overflow-wrap: anywhere;
}

/* ---------------- SOURCES ---------------- */

div[data-testid="stExpander"] {
    background: #F7FAFF !important;
    border: 1px solid #DCE7F5 !important;
    border-radius: 11px !important;
    margin-top: 12px;
}

div[data-testid="stExpander"] summary,
div[data-testid="stExpander"] summary span {
    color: #38669D !important;
    font-size: 13px !important;
    font-weight: 700 !important;
}

div[data-testid="stExpander"] [data-testid="stMarkdownContainer"],
div[data-testid="stExpander"] [data-testid="stMarkdownContainer"] * {
    color: #405B7C !important;
    font-size: 13px !important;
    line-height: 1.7 !important;
}

/* ---------------- MESSAGE COMPOSER ---------------- */

[data-testid="stBottom"] {
    background: rgba(243, 247, 253, .97) !important;
    border-top: 1px solid #DCE7F5 !important;
}

[data-testid="stBottom"] > div {
    max-width: 900px !important;
    padding-top: 12px !important;
}

[data-testid="stChatInput"] {
    background: #FFFFFF !important;
    border: 1px solid #C9D9EF !important;
    border-radius: 17px !important;
    box-shadow: 0 4px 18px rgba(35, 75, 120, .08) !important;
}

[data-testid="stChatInput"] textarea {
    color: #263D59 !important;
    -webkit-text-fill-color: #263D59 !important;
