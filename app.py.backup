    font-size: 15.5px !important;
}

[data-testid="stChatInput"] textarea::placeholder {
    color: #879BB5 !important;
    -webkit-text-fill-color: #879BB5 !important;
}

[data-testid="stChatInput"] button {
    background: #3478D4 !important;
    color: #FFFFFF !important;
    border-radius: 10px !important;
}

/* ---------------- LINKS & DIVIDERS ---------------- */

.stApp a {
    color: #286AC0 !important;
}

hr {
    border-color: #DCE7F5 !important;
}

/* ---------------- RESPONSIVE ---------------- */

@media (max-width: 700px) {
    [data-testid="stMainBlockContainer"] {
        padding: 1rem 1rem 6rem;
    }

    .welcome {
        padding-top: 35px;
    }

    .welcome h1 {
        font-size: 25px !important;
    }

    .user-bubble {
        max-width: 90%;
    }

    .topbar-status {
        font-size: 9px;
    }
}
</style>
""", unsafe_allow_html=True)


# ---------------- LOAD RAG PIPELINE ----------------

@st.cache_resource(show_spinner="Loading MediFlow knowledge base...")
def load_pipeline():
    pipeline = RAGPipeline(KB_DIR)
    pipeline.build_index()
    return pipeline


try:
    pipeline = load_pipeline()
except Exception as exc:
    st.error(f"Could not build knowledge base: {exc}")
    st.stop()


# ---------------- API KEY ----------------

def get_api_key():
    key = os.getenv("GEMINI_API_KEY")

    if key:
        return key

    try:
        return st.secrets.get("GEMINI_API_KEY")
    except Exception:
        return None


api_key = get_api_key()


# ---------------- SESSION STATE ----------------

if "messages" not in st.session_state:
    st.session_state.messages = []


# ---------------- SIDEBAR ----------------

with st.sidebar:

    st.markdown("""
    <div class="sidebar-brand">
        <div class="sidebar-logo">🩺</div>
        <div>
            <div class="sidebar-name">MediFlow AI</div>
            <div class="sidebar-caption">Your project assistant</div>
        </div>
    </div>
    """, unsafe_allow_html=True)

    if st.button("＋  New chat", use_container_width=True):
        st.session_state.messages = []
        st.rerun()

    st.markdown(
        '<div class="sidebar-label">YOUR KNOWLEDGE BASE</div>',
        unsafe_allow_html=True,
    )

    with st.expander(
        f"📚 Documents ({len(pipeline.list_documents())})",
        expanded=False,
    ):
        for name in pipeline.list_documents():
            st.markdown(
                f'<div class="document-item">'
                f'📄 &nbsp; {html.escape(name)}</div>',
                unsafe_allow_html=True,
            )

    st.markdown("---")

    st.markdown(
        '<div class="sidebar-label">ABOUT MEDIFLOW AI</div>',
        unsafe_allow_html=True,
    )

    st.markdown(
        '<div class="sidebar-note">'
        'An intelligent assistant for the MediFlow Smart Medical '
        'Appointment & Queue Optimization System.'
        '</div>',
        unsafe_allow_html=True,
    )

    st.markdown("---")

    st.markdown(
        '<div class="sidebar-note">'
        'Answers are grounded in project documents. '
        'Medical diagnosis and treatment advice are not provided.'
        '</div>',
        unsafe_allow_html=True,
    )

    if not api_key:
        st.warning("GEMINI_API_KEY not found. Check your .env file.")


# ---------------- TOP BAR ----------------

st.markdown("""
<div class="topbar">
    <div class="topbar-brand">🩺 &nbsp; MediFlow Assistant</div>
    <div class="topbar-status">● Knowledge base connected</div>
</div>
""", unsafe_allow_html=True)


# ---------------- WELCOME SCREEN ----------------

if not st.session_state.messages:

    st.markdown("""
    <div class="welcome">
        <div class="welcome-icon">🩺</div>
        <h1>How can I help you today?</h1>
        <p>
            Ask me anything about MediFlow. I'll find answers
            from the project's documentation.
        </p>
    </div>
    """, unsafe_allow_html=True)

    st.markdown(
        '<div class="suggestion-heading">Explore MediFlow</div>',
        unsafe_allow_html=True,
    )

    examples = [
        "How do I register on MediFlow?",
        "How do I book an appointment?",
        "What does CHECKED_IN mean?",
        "How can doctors manage appointments?",
    ]

    col1, col2 = st.columns(2)

    for i, example in enumerate(examples):

        with (col1 if i % 2 == 0 else col2):

            if st.button(
                example,
                key=f"suggestion_{i}",
                use_container_width=True,
            ):
                st.session_state.pending = example
                st.rerun()


# ---------------- MESSAGE RENDERING ----------------

def render_user_message(content):
    safe_content = html.escape(content).replace("\n", "<br>")

    st.markdown(
        f'<div class="user-row">'
        f'<div class="user-bubble">{safe_content}</div>'
        f'</div>',
        unsafe_allow_html=True,
    )


def render_sources(sources):

    if not sources:
        return

    with st.expander("📚 Sources used"):

        for source in sources:
            filename = html.escape(source["source"])
            heading = html.escape(source["heading"])

            st.markdown(
                f"- **{filename}** — {heading} "
                f"*(match: {source['score']:.2f})*"
            )


# ---------------- CHAT HISTORY ----------------

for msg in st.session_state.messages:

    if msg["role"] == "user":

        render_user_message(msg["content"])

    else:

        with st.chat_message("assistant", avatar="🩺"):
            st.markdown(msg["content"])
            render_sources(msg.get("sources", []))


# ---------------- USER INPUT ----------------

pending_question = st.session_state.pop("pending", None)

question = st.chat_input("Message MediFlow AI...") or pending_question

if question:

    history = list(st.session_state.messages)

    st.session_state.messages.append({
        "role": "user",
        "content": question,
    })

    render_user_message(question)

    with st.chat_message("assistant", avatar="🩺"):

        with st.spinner("Looking through MediFlow documentation..."):

            try:
                result = pipeline.answer(
                    question,
                    history=history,
                    api_key=api_key,
                )

                answer = result["answer"]
                sources = result["sources"]

            except Exception as exc:

                answer = (
                    "Sorry, I couldn't generate an answer right now.\n\n"
                    f"**Error:** {exc}"
                )

                sources = []

        st.markdown(answer)
        render_sources(sources)

    st.session_state.messages.append({
        "role": "assistant",
        "content": answer,
        "sources": sources,
    })
